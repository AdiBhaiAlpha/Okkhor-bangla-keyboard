    <!-- Privacy -->
    <string name="privacy_title">Privacy &amp; Security</string>
    <string name="privacy_badge_offline">Local-Only Typing &amp; Emoji Data</string>
    <string name="privacy_summary">Okkhor Bangla Keyboard stores your typing memory, shortcuts, clipboard history, and emoji favorites/recents locally on your device. It contains no advertising or analytics SDKs. Optional Internet access is used only when you actively search or browse GIFs (which you can disable anytime in Settings), and typed messages are never uploaded to GIF providers. Optional Microphone permission is used only when you tap Voice Typing.</string>
    <string name="privacy_password_policy">Sensitive Fields Protection: When typing in password fields or credit card inputs, autocorrect, suggestions, learning, key previews, and clipboard history are automatically disabled.</string>

