# GEMINI_API_KEY: Unused in this app (kept commented so it is not packaged).
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# GIPHY_API_KEY: Optional API key for live GIF search & trending GIFs via GIPHY API v1.
# Configure this securely via the AI Studio Secrets panel.
# When left as placeholder or blank, Okkhor keeps standard emojis and Emoji Kitchen offline-ready
# and shows an explicit configuration notice in the GIF tab.
GIPHY_API_KEY=MY_GIPHY_API_KEY
